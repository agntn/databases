{
  "$schema": "node_modules/wrangler/config-schema.json",
  /*
   * Workers Builds deploys this from `docs/` on every push to main (`pnpm run build`,
   * then `npx wrangler deploy`), and pnpm there installs the whole workspace from the root
   * lockfile. Node comes from the root `.node-version`, since Workers Builds never reads
   * `engines`. Both D1 databases are EU only.
   */
  "name": "agntn-databases",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://databases.agntn.dev",
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-databases",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "routes": [{ "pattern": "databases.agntn.dev", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },

  // Previews
  "previews": {
    "vars": {
      "NUXT_SITE_URL": "https://databases.agntn.dev",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "00000000-0000-0000-0000-000000000000",
      },
    ],
  },
}
